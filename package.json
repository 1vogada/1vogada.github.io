{
  "name": "kiripad-dev",
  "private": true,
  "description": "kiripad.dev: the static site and its browser test suite (no build step; the site itself needs none of this)",
  "scripts": {
    "test": "NEXT=1 node --test --test-concurrency=1 --test-reporter=spec \"tests/scenarios/*.test.js\"",
    "test:legacy": "node --test --test-concurrency=1 --test-reporter=spec \"tests/scenarios/*.test.js\"",
    "test:golden": "UPDATE_GOLDEN=1 node --test --test-concurrency=1 --test-reporter=spec \"tests/scenarios/*.test.js\"",
    "check:legacy": "node tests/helpers/check-legacy-move.js",
    "stamp": "node scripts/stamp.mjs",
    "stamp:check": "node scripts/stamp.mjs --check"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
